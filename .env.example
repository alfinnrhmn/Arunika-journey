# Lihat PRD Lampiran B. Salin menjadi .env lalu isi. Jangan pernah commit .env.

# Database lokal (dipakai docker-compose.yml). Postgres 17 di semua lingkungan.
DB_NAME=arunika
DB_USER=arunika
DB_PASSWORD=ganti-dengan-sandi-acak
# Dipakai aplikasi yang jalan di host (npm run dev). Samakan dengan nilai di atas.
DATABASE_URL=postgres://arunika:ganti-dengan-sandi-acak@localhost:5432/arunika

BETTER_AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
PUBLIC_SITE_URL=http://localhost:4321

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_KEY=
S3_SECRET=
PAYMENT_PROVIDER=manual
PAYMENT_SERVER_KEY=
PAYMENT_WEBHOOK_SECRET=
EMAIL_API_KEY=
EMAIL_FROM=
TURNSTILE_SITE=
TURNSTILE_SECRET=
SENTRY_DSN=
