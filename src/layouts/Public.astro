---
import '../styles/global.css';
import HFFooterRD from '../components/hf/HFFooterRD.astro';

interface Props {
  title: string;
  description?: string;
  /** Alur fokus (booking, pembayaran) memakai header/footer sendiri. */
  hideFooter?: boolean;
}
const {
  title,
  description = 'Arunika Journey: travel beyond the itinerary.',
  hideFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
    <title>{title}</title>
  </head>
  <body id="top">
    <slot />
    {!hideFooter && <HFFooterRD />}
  </body>
</html>
