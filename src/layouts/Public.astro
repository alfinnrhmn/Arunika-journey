---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Arunika Journey: travel beyond the itinerary.' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
    <title>{title}</title>
  </head>
  <body class="bg-paper text-ink min-h-screen">
    <slot />
  </body>
</html>
