---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Arunika Dashboard</title>
  </head>
  <body class="bg-dash-bg text-dash-text font-dash min-h-screen">
    <slot />
  </body>
</html>
