---
// Rincian harga (rupa sama dengan HFPriceSummary). Dibuat terpisah karena pratinjau langsung di browser
// membangun ulang isinya (src/scripts/booking-flow.ts); gaya Astro yang bercakupan tidak menjangkau elemen
// buatan skrip, jadi gayanya global (bf-ps di booking-flow.css). Angka dari `calcPrice`/`priceFor` di server.
import { formatRupiah } from '../../../lib/format';
import type { PriceResult } from '../../../features/pricing/pricing';

interface Props {
  price: PriceResult | null;
  heading?: string;
  /** Penanda untuk skrip pratinjau; false di tempat yang harga tetapnya tidak boleh berubah. */
  live?: boolean;
}
const { price, heading = 'Rincian harga', live = false } = Astro.props;
---

<div class="bf-ps" data-bf-price={live ? '' : undefined}>
  <div class="bf-ps-h">{heading}</div>
  {price ? (
    <>
      {price.lines.map((l) => (
        <div class="row">
          <span>
            {formatRupiah(l.unitPrice)} × {l.qty} {l.label === 'Anak' ? 'anak' : 'peserta'}
          </span>
          <span>{formatRupiah(l.amount)}</span>
        </div>
      ))}
      <div class="row">
        <span>Biaya tambahan</span>
        <span>Tidak ada</span>
      </div>
      <div class="row total">
        <span>Total</span>
        <strong>{formatRupiah(price.total)}</strong>
      </div>
      <div class="dp">
        <div class="row">
          <span>DP ({price.dpPercent}%)</span>
          <strong>{formatRupiah(price.dp)}</strong>
        </div>
        <p>Sisa {formatRupiah(price.balance)} dilunasi sesuai jadwal pelunasan [diisi klien].</p>
      </div>
    </>
  ) : (
    <p class="bf-ps-empty">Pilih tanggal dan jumlah peserta untuk melihat harga.</p>
  )}
</div>
