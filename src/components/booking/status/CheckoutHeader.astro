---
// Header alur fokus (frame "HFCheckoutHeaderDesktop"): wordmark di kiri, bantuan di kanan. Tautan WhatsApp
// disembunyikan sampai klien memberi nomor; gantinya tautan Cek Status agar sisi kanan tidak kosong.
// Di tablet dan mobile (frame kecil) wordmark diganti tombol kembali dengan judul langkah, dan bantuan
// menjadi tautan berikon; markup tambahan itu tersembunyi di desktop.
import { whatsappHref } from '../../trips/detail/words';

interface Props {
  /** Judul pendek di samping tombol kembali pada layar kecil (mis. "Pembayaran", "Konfirmasi"). */
  label?: string;
}
const { label = 'Status booking' } = Astro.props;
---

<header class="bs-head">
  <a class="bs-wm" href="/" aria-label="Arunika Journey, beranda">
    <span class="a">Arunika</span>
    <span class="j">Journey</span>
  </a>
  <a class="bs-back" href="/cek-status">
    <svg
      viewBox="0 0 24 24"
      width="22"
      height="22"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 12H4M10 6l-6 6 6 6"></path>
    </svg>
    <span class="sr">Kembali ke Cek Status. </span>
    <span class="t-tab">Status booking</span>
    <span class="t-mob">{label}</span>
  </a>
  <div class="bs-help">
    <span class="bs-help-q">Butuh bantuan?</span>
    {whatsappHref ? (
      <a class="bs-pill" href={whatsappHref} rel="noopener">
        <svg
          class="bs-pill-ic"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 5h14v10H10l-4 4v-4H5z"></path>
        </svg>
        <span>WhatsApp</span>
      </a>
    ) : (
      <a class="bs-pill" href="/cek-status">
        <svg
          class="bs-pill-ic"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 5h14v10H10l-4 4v-4H5z"></path>
        </svg>
        <span>Cek Status Booking</span>
      </a>
    )}
  </div>
</header>
