---
// Konfirmasi permintaan (frame Request a Quote Konfirmasi: desktop, tablet, mobile; varian Red Dot style).
// Komponen murni tampilan: semua nilai datang dari props (bawaan: data CONTOH di content/private-request.ts).
// Saat ini HANYA dipakai rute pratinjau pengembangan /private-trip/request/konfirmasi (404 di produksi) karena belum
// ada backend yang menerbitkan nomor permintaan. Sambungan tahap BE: rute konfirmasi sungguhan memberikan
// `code`, `rows`, dan tanggal kirim dari data tersimpan, bukan data contoh.
import HFBadge from '../../hf/HFBadge.astro';
import HFIcon from '../../hf/HFIcon.astro';
import HFNavRD from '../../hf/HFNavRD.astro';
import { whatsappHref } from '../../trips/detail/words';
import { confirm as c } from '../../../content/private-request';

interface Props {
  code?: string;
  rows?: [string, string][];
}
const { code = c.code.value, rows = c.summary.rows } = Astro.props;
const arrow = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>`;
---

<HFNavRD tone="solid" cta="Cek status" ctaHref="/cek-status" />
<main class="pr-cf">
  <section class="pr-cf-top">
    <span class="hand">{c.hand}</span>
    <h1>
      {c.titleA} <i>{c.titleI}</i>
    </h1>
    <p class="pr-cf-lead">{c.lead}</p>
    <div class="pr-cf-code">
      <div class="in">
        <div>
          <p class="pr-eyebrow">{c.code.label}</p>
          <p class="pr-cf-num">{code}</p>
        </div>
        <HFBadge label={c.code.badge} tone="pending" />
      </div>
      <p class="pr-cf-sent">{c.sent}</p>
    </div>
  </section>

  <section class="pr-cf-eta">
    <p class="pr-eyebrow">{c.eta.eyebrow}</p>
    <div class="pr-cf-etabox">
      <HFIcon name="clock" size={20} />
      <div>
        <h2>{c.eta.title}</h2>
        <p>{c.eta.text}</p>
      </div>
    </div>
  </section>

  <section class="pr-cf-cols">
    <div class="pr-cf-sum">
      <p class="pr-eyebrow ink">{c.summary.eyebrow}</p>
      <h2 class="pr-cf-h">
        {c.summary.titleA} <i>{c.summary.titleI}</i>
      </h2>
      <p class="pr-cf-sub">{c.summary.sub}</p>
      <dl class="pr-rows">
        {rows.map(([k, v]) => (
          <div class="pr-row">
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="pr-cf-next">
      <p class="pr-eyebrow ink">{c.next.eyebrow}</p>
      <h2 class="pr-cf-h">
        {c.next.titleA} <i>{c.next.titleI}</i> {c.next.titleB}
      </h2>
      <ol class="pr-tl pr-tl-m">
        {c.timeline.map((s) => (
          <li data-state={s.state} aria-current={s.state === 'now' ? 'step' : undefined}>
            <span class="dot" aria-hidden="true">
              {s.state === 'done' && <HFIcon name="check" size={16} />}
            </span>
            <p class="tag">{s.tag}</p>
            <h3>{s.title}</h3>
            <p class="d">{s.text}</p>
          </li>
        ))}
      </ol>
      <ol class="pr-tl pr-tl-d">
        {c.timeline.slice(1).map((s, i) => (
          <li>
            <p class="n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h3>{s.title}</h3>
            <p class="d">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="pr-cf-act">
    <div class="row">
      <a class="pr-btn" href={c.actions.statusHref}>
        <span class="l">{c.actions.status}</span>
        <span class="ic" set:html={arrow} />
      </a>
      <a
        class="pr-btn ghost pr-mob"
        href={whatsappHref ?? '/contact'}
        target={whatsappHref ? '_blank' : undefined}
        rel={whatsappHref ? 'noopener' : undefined}
      >
        <span class="l">{c.actions.contact}</span>
      </a>
      <a class="pr-ulink" href="/">
        {c.actions.home}
      </a>
    </div>
    <p class="pr-cf-keep">{c.actions.keep}</p>
  </section>
</main>
