---
// Blok tindakan yang BISA jalan tanpa backend: tautan WhatsApp (hanya bila nomor sudah diisi klien) dan cetak
// browser. Setujui, Minta revisi, dan Unduh PDF sengaja tidak ada: TITIK SAMBUNG BE ada di
// src/content/private-proposal.ts (endpoint persetujuan, pengiriman revisi, PDF server).
import HFArrowButton from '../../hf/HFArrowButton.astro';
import { whatsappHref } from '../../trips/detail/words';

interface Props {
  /** Teks pengantar di atas tombol. */
  lead?: string;
  waLabel?: string;
  /** Tampilkan tombol cetak (disembunyikan sampai JavaScript aktif). */
  print?: boolean;
  /** Warna tombol WhatsApp. */
  tone?: 'dark' | 'outline';
}
const { lead, waLabel = 'Hubungi lewat WhatsApp', print = true, tone = 'dark' } = Astro.props;
---

<div class="pp-contact">
  {lead && <p class="lead">{lead}</p>}
  {whatsappHref ? (
    <HFArrowButton tone={tone} label={waLabel} href={whatsappHref} />
  ) : (
    <p class="ph">
      Hubungi kami lewat WhatsApp <b>[nomor: diisi klien]</b>.
    </p>
  )}
  {print && (
    <button class="pp-btn pp-print" data-tone="secondary" type="button" data-print hidden>
      <span>Simpan atau cetak</span>
    </button>
  )}
</div>
