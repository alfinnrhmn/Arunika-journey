---
// FAQ: <details> bernama (satu terbuka sekali waktu), pertanyaan pertama terbuka seperti frame. Tanpa JS tetap terbaca.
import { ptFaq as f } from '../../../content/private-trip';
---

<section class="ptl-faq" aria-labelledby="ptl-faq-h">
  <div class="ptl-head">
    <p class="ptl-eyebrow ptl-eyebrow-ink">{f.eyebrow}</p>
    <h2 class="ptl-h2" id="ptl-faq-h">
      {f.titleA} <i>{f.titleI}</i>
      {` ${f.titleB}`}
    </h2>
  </div>
  <div class="ptl-faq-list">
    {f.items.map((it, i) => (
      <details class="ptl-qa" name="faq-private-trip" open={i === 0}>
        <summary>
          <span>{it.q}</span>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </summary>
        <p>{it.a}</p>
      </details>
    ))}
  </div>
</section>
