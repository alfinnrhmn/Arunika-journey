---
// Kartu pemesanan 440px. Dirender di server (tanpa JS tetap benar: tautan menuju langkah 1 dengan jadwal dan
// jumlah awal); skrip booking-card.ts menambahkan pilihan jadwal, jumlah peserta, dan pratinjau harga memakai
// `calcPrice` yang sama dengan server. Harga yang disimpan tetap dihitung server saat pembayaran dimulai.
// Tanpa jadwal terbuka: keadaan "Belum ada jadwal terbuka".
import HFArrowButton from '../../hf/HFArrowButton.astro';
import HFBadge from '../../hf/HFBadge.astro';
import HFIcon from '../../hf/HFIcon.astro';
import HFPriceSummary from '../../hf/HFPriceSummary.astro';
import { calcPrice } from '../../../features/pricing/pricing';
import { FEW_SEATS_THRESHOLD, seatLabel } from '../../../features/schedules/seats';
import { formatDateShort, formatDuration, formatRupiah } from '../../../lib/format';
import type { TripDetail } from '../../../features/trips/queries';
import { whatsappHref } from './words';

interface Props {
  trip: TripDetail;
  /** Persentase DP dari Pengaturan (bawaan 30). */
  dpPercent?: number;
  /** Maksimal peserta per booking dari Pengaturan (bawaan 8). */
  maxParticipants?: number;
}
const { trip, dpPercent = 30, maxParticipants = 8 } = Astro.props;

/** Jumlah peserta awal pada kartu. */
const DEFAULT_PARTICIPANTS = 2;

const selected = trip.schedules.find((s) => s.bookable) ?? null;
/** Batas jumlah peserta untuk jadwal terpilih: Pengaturan dan sisa kursi, yang lebih kecil. */
const capFor = (left: number) => Math.max(1, Math.min(maxParticipants, left));
const participants = selected
  ? Math.min(DEFAULT_PARTICIPANTS, capFor(selected.seatsLeft))
  : DEFAULT_PARTICIPANTS;
const price = selected
  ? calcPrice({
      unitPrice: selected.price,
      childPrice: null,
      adults: participants,
      dpPercent,
    })
  : null;

const tone = { ok: 'ok', few: 'pending', full: 'full' } as const;
const duration = formatDuration(trip.durationDays, trip.nights);

// Pesan kuota: sisa sedikit berwarna kuning; selain itu hijau. (Skrip menghitung ulang dengan aturan yang sama.)
let quota: { tone: 'ok' | 'pending'; text: string } | null = null;
if (selected) {
  quota =
    selected.seatsLeft <= FEW_SEATS_THRESHOLD
      ? { tone: 'pending', text: `Hanya tersisa ${selected.seatsLeft} kursi untuk jadwal ini` }
      : { tone: 'ok', text: `Kuota tersedia untuk ${participants} peserta` };
}

const bookHref = selected
  ? `/booking/${trip.slug}/jadwal?jadwal=${selected.id}&peserta=${participants}`
  : '';
const WaTag = whatsappHref ? 'a' : 'span';
---

<div class="td-book-wrap" id="pesan">
  <div class="td-book-head">
    <span class="hand">Jadwal dan harga</span>
    <h3 class="td-sub-h">
      {selected ? (
        <>
          Pilih <i>tanggal</i>
        </>
      ) : (
        <>
          Belum ada <i>jadwal</i> terbuka
        </>
      )}
    </h3>
  </div>
  <aside
    class="td-book"
    aria-label="Pemesanan"
    data-slug={trip.slug}
    data-dp={dpPercent}
    data-max={maxParticipants}
    data-threshold={FEW_SEATS_THRESHOLD}
  >
    <div class="td-cap">Harga mulai dari</div>
    <div class="td-book-price">
      <span class="td-book-amount">{formatRupiah(trip.basePrice)}</span>
      <span class="td-book-per">/ orang</span>
    </div>
    <div class="td-book-note">
      Harga per orang. DP {dpPercent}%. Penahanan kursi: [dikonfirmasi klien].
    </div>

    {trip.schedules.length > 0 && (
      <>
        <div class="td-label" id="td-sched-label">
          Pilih tanggal
        </div>
        <div class="td-scheds" role="radiogroup" aria-labelledby="td-sched-label">
          {trip.schedules.map((s) => {
            const state =
              s.status === 'full' || !s.bookable
                ? 'full'
                : s.id === selected?.id
                  ? 'selected'
                  : 'idle';
            return (
              <div
                class="td-sched"
                data-state={state}
                data-id={s.id}
                data-price={s.price}
                data-left={s.seatsLeft}
                role="radio"
                aria-checked={state === 'selected' ? 'true' : 'false'}
                aria-disabled={state === 'full' ? 'true' : undefined}
                tabindex={state === 'full' ? undefined : 0}
              >
                <span class="td-radio" aria-hidden="true" />
                <div class="td-sched-t">
                  <b>{formatDateShort(s.departureDate)}</b>
                  <br />
                  <small>{duration}</small>
                </div>
                <HFBadge label={seatLabel(s.seatsLeft)} tone={tone[s.status]} />
              </div>
            );
          })}
        </div>
      </>
    )}

    {selected && price && quota ? (
      <>
        <div class="td-qty">
          <span class="td-qty-label" id="td-qty-label">
            Jumlah peserta
          </span>
          <div class="td-qty-ctl" role="group" aria-labelledby="td-qty-label">
            <button
              type="button"
              class="td-qty-btn"
              data-qty="minus"
              aria-label="Kurangi peserta"
              disabled={participants <= 1}
            >
              <HFIcon name="minus" size={20} />
            </button>
            <span class="td-qty-n" data-qty-n aria-live="polite">
              {participants}
            </span>
            <button
              type="button"
              class="td-qty-btn"
              data-qty="plus"
              aria-label="Tambah peserta"
              disabled={participants >= capFor(selected.seatsLeft)}
            >
              <HFIcon name="plus" size={20} />
            </button>
          </div>
        </div>
        <div class="td-quota" data-tone={quota.tone} data-quota>
          <span class="td-quota-ic" data-ic="ok">
            <HFIcon name="check" size={20} />
          </span>
          <span class="td-quota-ic" data-ic="warn">
            <HFIcon name="users" size={20} />
          </span>
          <span data-quota-text>{quota.text}</span>
        </div>
        <div class="td-ps">
          <HFPriceSummary price={price} />
          <div class="td-vat">Harga sudah termasuk PPN</div>
        </div>
        <div class="td-full" data-book-link>
          <HFArrowButton tone="dark" label="Lanjut booking" href={bookHref} />
        </div>
      </>
    ) : (
      <div class="td-closed">
        <div class="td-closed-h">Belum ada jadwal terbuka</div>
        <p>
          Jadwal baru untuk trip ini belum dibuka. Ajukan Private Trip untuk tanggal dan rombongan
          pilihan Anda.
        </p>
        <div class="td-full">
          <HFArrowButton tone="dark" label="Request a Quote" href="/private-trip/request" />
        </div>
        <div class="td-vat">Harga sudah termasuk PPN</div>
      </div>
    )}

    <div class="td-wa">
      <WaTag class="td-link" href={whatsappHref}>
        Tanya via WhatsApp
      </WaTag>
    </div>
    <div class="td-trust">
      <div>
        <HFIcon name="shield" size={20} />
        <span>Legalitas usaha: [diisi klien]</span>
      </div>
      <div>
        <HFIcon name="file" size={20} />
        <span>Kebijakan batal tertulis sebelum Anda bayar</span>
      </div>
      <div>
        <HFIcon name="check" size={20} />
        <span>Cek Status Booking: Pending Payment atau Confirmed</span>
      </div>
    </div>
  </aside>
</div>
