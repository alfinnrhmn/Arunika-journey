---
// Testimoni contoh (statis seperti desain). Ulasan asli hanya dari peserta yang berangkat; pager hanya hiasan.
import { foto } from '../../../lib/photo';
import { photoSize } from '../photo-size';
---

<section class="td-voices">
  <h3>
    Kata <i>peserta</i> kami
  </h3>
  <div class="td-voice">
    <div class="td-voice-q">
      Perjalanan keluarga tiga generasi kami diatur dengan sangat baik oleh tim Arunika. Rasanya
      sulit membayangkan bisa lebih baik dari ini.
    </div>
    <div class="td-voice-by">
      <b>[Nama peserta], [Trip] · [Bulan tahun]</b>
      <span>Contoh teks. Ulasan asli hanya dari peserta yang berangkat.</span>
    </div>
    <div class="td-voice-pager" aria-hidden="true">
      <span>01 / 05</span>
      <span class="td-voice-btn">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5M11 6l-6 6 6 6"></path>
        </svg>
      </span>
      <span class="td-voice-btn">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </span>
    </div>
    <div class="td-voice-photo">
      <img
        class="cover"
        src={foto('potret-perempuan-tenun')}
        alt="Potret peserta berselendang tenun"
        {...photoSize('potret-perempuan-tenun')}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
