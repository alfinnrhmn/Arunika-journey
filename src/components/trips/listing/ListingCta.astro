---
import { foto } from '../../../lib/photo';
import HFArrowButton from '../../hf/HFArrowButton.astro';
import { photoSize } from '../photo-size';
---

<section class="tl33">
  <img
    class="cover tl34"
    src={foto('jip-4x4-bromo')}
    alt="Jip 4×4 melintasi lautan pasir Bromo"
    {...photoSize('jip-4x4-bromo')}
    loading="lazy"
    decoding="async"
  />
  <div class="tl35"></div>
  <div class="tl36">
    <h2 class="tl37">
      Pilih <i>petualanganmu</i>
    </h2>
    <p class="tl38">
      Pilih jadwal sekarang atau tanya via WhatsApp. Toh, jurnal perjalananmu tidak akan menulis
      dirinya sendiri.
    </p>
    <div class="tl39">
      <HFArrowButton tone={'light'} label={'Lihat jadwal Open Trip'} href={'/trips'} />
      <a class="tl40" href="/private-trip/request">
        Atau Request a Quote untuk Private Trip
      </a>
    </div>
  </div>
</section>
