---
import { foto } from '../../../lib/photo';
import HFArrowButton from '../../hf/HFArrowButton.astro';
import { photoSize } from '../photo-size';
---

<section class="tl26">
  <div class="tl27">
    <span class="hand">Temui tim kami</span>
    <h3 class="tl28">
      Bicara dengan tim kami untuk <i>merencanakan</i> trip Anda
    </h3>
    <p class="tl29">
      Belum menemukan tanggal atau rute yang pas? Tim kami meluangkan waktu untuk memahami apa yang
      Anda cari, lalu membantu memilih Open Trip yang tepat atau menyusun Private Trip dari awal.
    </p>
    <div class="tl30">
      <HFArrowButton tone={'dark'} label={'Ajukan pertanyaan'} href={'/contact'} />
      <a class="tl31" href="/contact">
        Tanya via WhatsApp
      </a>
    </div>
  </div>
  <div class="tl32">
    <div class="tl-px" data-parallax>
      <img
        class="cover"
        src={foto('tim-arunika-obrolan')}
        alt="Anggota tim Arunika berbincang akrab dengan dua perempuan sepuh di tepi jalan"
        {...photoSize('tim-arunika-obrolan')}
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<script>
  import { initParallax } from '../../../lib/motion/parallax';
  initParallax();
</script>
