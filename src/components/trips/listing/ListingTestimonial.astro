---
// Karusel testimoni (desktop >= 1024; frame tablet/mobile tidak memuat bagian ini). Gerakannya sama dengan karusel
// testimoni di Home: foto tersingkap dari kanan (clip-path), foto membesar-mengecil perlahan, kutipan naik
// belakangan. Tanpa JS slide pertama tampil statis dan tombol tidak muncul (tidak ada kontrol palsu).
import { foto } from '../../../lib/photo';
import { LISTING_TESTIMONIALS } from '../../../content/listing-testimonials';
import { photoSize } from '../photo-size';

const slides = LISTING_TESTIMONIALS;
const pad = (n: number) => String(n).padStart(2, '0');
const arrow = (d: string) =>
  `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"></path></svg>`;
---

<section
  class="tl16"
  aria-roledescription="carousel"
  aria-label="Testimoni peserta"
  data-tl-carousel
>
  <h3 class="tl17">
    Dalam <i>kata</i> mereka
  </h3>
  <div class="tl18">
    {slides.map((s, i) => (
      <div
        class:list={['tl-slide', { on: i === 0 }]}
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} dari ${slides.length}`}
        aria-hidden={i === 0 ? undefined : 'true'}
        data-tl-slide
      >
        <div class="tl19">{s.quote}</div>
        <div class="tl20">
          <b class="tl21">{s.who}</b>
          <span>{s.note}</span>
        </div>
        <div class="tl25">
          <img
            class="cover"
            src={foto(s.photo)}
            alt={s.alt}
            {...photoSize(s.photo)}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    ))}
    <div class="tl22" hidden data-tl-ctl>
      <span class="tl23">
        <span data-tl-cur>{pad(1)}</span>
        {` / ${pad(slides.length)}`}
      </span>
      <button
        type="button"
        class="tl24 tl-nav"
        aria-label="Testimoni sebelumnya"
        data-tl-prev
        set:html={arrow('M19 12H5M11 6l-6 6 6 6')}
      />
      <button
        type="button"
        class="tl24 tl-nav"
        aria-label="Testimoni berikutnya"
        data-tl-next
        set:html={arrow('M5 12h14M13 6l6 6-6 6')}
      />
    </div>
  </div>
  <p class="tl-sr" role="status" aria-live="polite" data-tl-status></p>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-tl-carousel]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-tl-slide]')];
    const ctl = root.querySelector<HTMLElement>('[data-tl-ctl]');
    const cur = root.querySelector<HTMLElement>('[data-tl-cur]');
    const status = root.querySelector<HTMLElement>('[data-tl-status]');
    const card = root.querySelector<HTMLElement>('.tl18');
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 1024px)');
    const pad = (n: number) => String(n).padStart(2, '0');
    let index = 0;
    let timer = 0;
    let inView = false;
    let held = false;

    function go(n: number, announce: boolean): void {
      const prev = index;
      index = (n + slides.length) % slides.length;
      if (index === prev) return;
      slides.forEach((s, i) => {
        s.classList.remove('on', 'prev');
        if (i === index) s.classList.add('on');
        else if (i === prev) s.classList.add('prev');
        if (i === index) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      if (cur) cur.textContent = pad(index + 1);
      if (announce && status) status.textContent = `Testimoni ${index + 1} dari ${slides.length}`;
    }

    // Pergantian otomatis tiap 8 detik seperti di Home, tetapi hanya selagi bagian ini terlihat, tidak ditahan
    // kursor/fokus, dan pengguna tidak memilih "kurangi gerakan".
    function auto(): void {
      window.clearInterval(timer);
      timer = 0;
      if (calm.matches || !desktop.matches || !inView || held) return;
      timer = window.setInterval(() => go(index + 1, false), 8000);
    }
    function manual(n: number): void {
      go(n, true);
      auto();
    }

    if (slides.length > 1 && ctl) {
      ctl.hidden = false;
      root.querySelector('[data-tl-prev]')?.addEventListener('click', () => manual(index - 1));
      root.querySelector('[data-tl-next]')?.addEventListener('click', () => manual(index + 1));

      new IntersectionObserver(
        (es) => {
          inView = es[0]?.isIntersecting ?? false;
          auto();
        },
        { threshold: 0.35 },
      ).observe(root);
      const hold = (v: boolean) => () => {
        held = v;
        auto();
      };
      card?.addEventListener('mouseenter', hold(true));
      card?.addEventListener('mouseleave', hold(false));
      card?.addEventListener('focusin', hold(true));
      card?.addEventListener('focusout', hold(false));
      calm.addEventListener('change', auto);
      desktop.addEventListener('change', auto);

      // Geser jari (layar sentuh lebar): ke kiri = berikutnya, ke kanan = sebelumnya.
      let x0: number | null = null;
      card?.addEventListener(
        'touchstart',
        (e) => {
          x0 = e.touches[0]?.clientX ?? null;
        },
        { passive: true },
      );
      card?.addEventListener(
        'touchend',
        (e) => {
          if (x0 === null) return;
          const dx = (e.changedTouches[0]?.clientX ?? x0) - x0;
          x0 = null;
          if (Math.abs(dx) > 40) manual(dx < 0 ? index + 1 : index - 1);
        },
        { passive: true },
      );
    }
  }
</script>
