---
import { photo } from '../../../lib/photo';
---

<section class="tl16">
  <h3 class="tl17">
    Dalam <i>kata</i> mereka
  </h3>
  <div class="tl18">
    <div class="tl19">
      Tim Arunika menyusun semuanya dengan sabar. Hotel, jadwal, dan harga jelas dari awal, sehingga
      kami bisa menikmati perjalanan tanpa rasa was-was.
    </div>
    <div class="tl20">
      <b class="tl21">[Nama peserta], [Trip] · [Bulan tahun]</b>
      <span>Contoh teks. Ulasan asli hanya dari peserta yang berangkat.</span>
    </div>
    <div class="tl22">
      <span class="tl23">02 / 06</span>
      <span class="tl24">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5M11 6l-6 6 6 6"></path>
        </svg>
      </span>
      <span class="tl24">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </span>
    </div>
    <div class="tl25">
      <img class="cover" src={photo('JIgL9Ncr7Q.jpg')} alt="Foto peserta" />
    </div>
  </div>
</section>
