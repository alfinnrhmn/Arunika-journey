---
import { photo } from '../../lib/photo';
import HFArrowButton from '../hf/HFArrowButton.astro';
---

<section id="dst" class="hp19">
  <!-- Foto latar membesar mengikuti scroll (src/lib/motion). Pembungkus ini yang diskalakan, bukan fotonya,
       agar efek zoom-out bawaan tiap slide tetap berjalan. -->
  <div class="dzoom" data-motion="zoom" data-zoom-to="1.22">
    <img class="dbg on" src={photo('_jOuphaFXK.webp')} alt="Panorama destinasi" />
    <img class="dbg" src={photo('UKC-V0YGdo.jpg')} alt="Dataran tinggi berkabut" />
    <img class="dbg" src={photo('AuaJr2d8Yj.jpg')} alt="Senja di balik pulau berpalem" />
    <img class="dbg" src={photo('-12f39P6ZX.jpg')} alt="Pulau kecil berhutan dari udara" />
    <img class="dbg" src={photo('kMG6Ggfz-2.jpg')} alt="Gunung berapi dengan padang savana" />
    <img
      class="dbg"
      src={photo('Ax4ePGh09L.jpg')}
      alt="Pantai pasir putih di antara pulau karang"
    />
  </div>
  <div class="hp20"></div>
  <div class="dpan on hp21">
    <div class="hp22">
      <img class="cover" src={photo('Dtqyc6HQrR.webp')} alt="Destinasi 2" />
    </div>
    <div class="hp23">
      <img class="cover" src={photo('j9jq9Vt-pq.webp')} alt="Destinasi 1" />
    </div>
    <div class="hp24">
      <img class="cover" src={photo('0QPFDGcXqT.webp')} alt="Destinasi 3" />
    </div>
  </div>
  <div class="dpan hp25">
    <div class="hp22">
      <img class="cover" src={photo('omZHPNPiv5.jpg')} alt="Dieng 2" />
    </div>
    <div class="hp23">
      <img class="cover" src={photo('AuaJr2d8Yj.jpg')} alt="Dieng 1" />
    </div>
    <div class="hp24">
      <img class="cover" src={photo('_wEc-c7pQz.jpg')} alt="Dieng 3" />
    </div>
  </div>
  <div class="dpan hp25">
    <div class="hp22">
      <img class="cover" src={photo('1TPQn7_DUw.jpg')} alt="Yogyakarta 2" />
    </div>
    <div class="hp23">
      <img class="cover" src={photo('2en6TErKPe.jpg')} alt="Yogyakarta 1" />
    </div>
    <div class="hp24">
      <img class="cover" src={photo('omZHPNPiv5.jpg')} alt="Yogyakarta 3" />
    </div>
  </div>
  <div class="dpan hp25">
    <div class="hp22">
      <img class="cover" src={photo('Ax4ePGh09L.jpg')} alt="Karimunjawa 2" />
    </div>
    <div class="hp23">
      <img class="cover" src={photo('_wEc-c7pQz.jpg')} alt="Karimunjawa 1" />
    </div>
    <div class="hp24">
      <img class="cover" src={photo('AuaJr2d8Yj.jpg')} alt="Karimunjawa 3" />
    </div>
  </div>
  <div class="dpan hp25">
    <div class="hp22">
      <img class="cover" src={photo('UKC-V0YGdo.jpg')} alt="Ijen 2" />
    </div>
    <div class="hp23">
      <img class="cover" src={photo('omZHPNPiv5.jpg')} alt="Ijen 1" />
    </div>
    <div class="hp24">
      <img class="cover" src={photo('-12f39P6ZX.jpg')} alt="Ijen 3" />
    </div>
  </div>
  <div class="dpan hp25">
    <div class="hp22">
      <img class="cover" src={photo('-12f39P6ZX.jpg')} alt="Destinasi lainnya 2" />
    </div>
    <div class="hp23">
      <img class="cover" src={photo('2en6TErKPe.jpg')} alt="Destinasi lainnya 1" />
    </div>
    <div class="hp24">
      <img class="cover" src={photo('1TPQn7_DUw.jpg')} alt="Destinasi lainnya 3" />
    </div>
  </div>
  <div class="hp26">
    <div id="dcount" class="hp27">
      Destinasi · 01 dari 06
    </div>
    <h2 id="dtitle" class="hp28">
      Bromo
    </h2>
    <p id="ddesc" class="hp29">
      Matahari terbit di atas lautan kabut, jip 4×4 melintasi lautan pasir, dan kawah yang masih
      mengepulkan asap.
    </p>
    <div id="dbtn" class="hp30">
      <HFArrowButton href={'/trips'} label={'Lihat trip ke Bromo'} tone={'light'} />
    </div>
  </div>
  <div class="hp31">
    <div id="dbar" class="hp32">
      <div class="hp33">
        <span class="hp34">01</span>Bromo
      </div>
      <div class="hp35">
        <span class="hp36">02</span>Dieng
      </div>
      <div class="hp35">
        <span class="hp36">03</span>Yogyakarta
      </div>
      <div class="hp35">
        <span class="hp36">04</span>Karimunjawa
      </div>
      <div class="hp35">
        <span class="hp36">05</span>Ijen
      </div>
      <div class="hp35">
        <span class="hp36">06</span>Destinasi lainnya
      </div>
    </div>
    <div id="darrows" class="hp37">
      <span class="hp38">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5M11 6l-6 6 6 6"></path>
        </svg>
      </span>
      <span class="hp38">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </span>
    </div>
  </div>
</section>
