---
import { fi } from './dims';
import HFArrowButton from '../hf/HFArrowButton.astro';
---

<section id="dst" class="hp19 hd">
  <img
    class="dbg on"
    {...fi('penanjakan-panorama')}
    loading="lazy"
    decoding="async"
    alt="Panorama Bromo dari Penanjakan"
  />
  <img
    class="dbg"
    {...fi('dieng-teras-kabut')}
    loading="lazy"
    decoding="async"
    alt="Teras kebun berkabut di dataran tinggi Dieng"
  />
  <img
    class="dbg"
    {...fi('prambanan-senja')}
    loading="lazy"
    decoding="async"
    alt="Candi Prambanan saat senja"
  />
  <img
    class="dbg"
    {...fi('sandbar-perahu')}
    loading="lazy"
    decoding="async"
    alt="Perahu di sandbar pasir putih Karimunjawa"
  />
  <img
    class="dbg"
    {...fi('kawah-ijen')}
    loading="lazy"
    decoding="async"
    alt="Danau kawah Ijen berasap"
  />
  <img
    class="dbg"
    {...fi('savana-banyuwangi')}
    loading="lazy"
    decoding="async"
    alt="Savana kuning di bawah langit senja"
  />
  <div class="hp20"></div>
  <div class="dpan on hp21">
    <div class="hp22">
      <img
        class="cover"
        {...fi('bromo-tangga-batu')}
        loading="lazy"
        decoding="async"
        alt="Pendaki menaiki tangga batu menuju kawah Bromo"
      />
    </div>
    <div class="hp23">
      <img
        class="cover"
        {...fi('warga-tengger-bromo')}
        loading="lazy"
        decoding="async"
        alt="Warga Tengger menikmati minuman hangat di Bromo"
      />
    </div>
    <div class="hp24">
      <img
        class="cover"
        {...fi('roda-jip-pasir')}
        loading="lazy"
        decoding="async"
        alt="Roda jip di lautan pasir Bromo"
      />
    </div>
  </div>
  <div class="dpan hp25">
    <div class="hp22">
      <img
        class="cover"
        {...fi('sikunir-lautan-awan')}
        loading="lazy"
        decoding="async"
        alt="Lautan awan dari puncak Sikunir"
      />
    </div>
    <div class="hp23">
      <img
        class="cover"
        {...fi('kebun-teh')}
        loading="lazy"
        decoding="async"
        alt="Kebun teh berundak di dataran tinggi"
      />
    </div>
    <div class="hp24">
      <img
        class="cover"
        {...fi('dieng-sunrise-emas')}
        loading="lazy"
        decoding="async"
        alt="Dua pejalan di jalur Dieng saat fajar"
      />
    </div>
  </div>
  <div class="dpan hp25">
    <div class="hp22">
      <img
        class="cover"
        {...fi('borobudur-stupa')}
        loading="lazy"
        decoding="async"
        alt="Stupa Borobudur berkabut"
      />
    </div>
    <div class="hp23">
      <img
        class="cover"
        {...fi('prambanan-fajar')}
        loading="lazy"
        decoding="async"
        alt="Prambanan saat fajar"
      />
    </div>
    <div class="hp24">
      <img
        class="cover"
        {...fi('batik-tulis')}
        loading="lazy"
        decoding="async"
        alt="Tangan menggambar batik tulis"
      />
    </div>
  </div>
  <div class="dpan hp25">
    <div class="hp22">
      <img
        class="cover"
        {...fi('pulau-udara-perahu')}
        loading="lazy"
        decoding="async"
        alt="Pulau Karimunjawa dari udara"
      />
    </div>
    <div class="hp23">
      <img
        class="cover"
        {...fi('haluan-perahu-laut')}
        loading="lazy"
        decoding="async"
        alt="Haluan perahu kayu di laut jernih"
      />
    </div>
    <div class="hp24">
      <img
        class="cover"
        {...fi('senja-perahu-tenang')}
        loading="lazy"
        decoding="async"
        alt="Perahu di laut tenang saat senja"
      />
    </div>
  </div>
  <div class="dpan hp25">
    <div class="hp22">
      <img
        class="cover"
        {...fi('ijen-api-biru')}
        loading="lazy"
        decoding="async"
        alt="Api biru Ijen pada malam hari"
      />
    </div>
    <div class="hp23">
      <img
        class="cover"
        {...fi('pendaki-malam-headlamp')}
        loading="lazy"
        decoding="async"
        alt="Pendaki dengan headlamp di punggungan malam"
      />
    </div>
    <div class="hp24">
      <img
        class="cover"
        {...fi('ijen-kawah-pendaki')}
        loading="lazy"
        decoding="async"
        alt="Pendaki di tepi kawah Ijen"
      />
    </div>
  </div>
  <div class="dpan hp25">
    <div class="hp22">
      <img
        class="cover"
        {...fi('savana-pendaki-barisan')}
        loading="lazy"
        decoding="async"
        alt="Barisan pendaki menyeberangi savana"
      />
    </div>
    <div class="hp23">
      <img
        class="cover"
        {...fi('ubud-pendopo-sawah')}
        loading="lazy"
        decoding="async"
        alt="Pendopo di tepi sawah berkabut"
      />
    </div>
    <div class="hp24">
      <img
        class="cover"
        {...fi('sawah-teras-ubud')}
        loading="lazy"
        decoding="async"
        alt="Sawah berteras di Ubud"
      />
    </div>
  </div>
  <div class="hp26">
    <div id="dcount" class="hp27">
      Destinasi · 01 dari 06
    </div>
    <h2 id="dtitle" class="hp28">
      Bromo
    </h2>
    <p id="ddesc" class="hp29">
      Matahari terbit di atas lautan kabut, jip 4×4 melintasi lautan pasir, dan kawah yang masih
      mengepulkan asap.
    </p>
    <div id="dbtn" class="hp30">
      <HFArrowButton href={'/trips'} label={'Lihat trip ke Bromo'} tone={'light'} />
    </div>
  </div>
  <div class="hp31">
    <div id="dbar" class="hp32">
      <div class="hp33">
        <span class="hp34">01</span>Bromo
      </div>
      <div class="hp35">
        <span class="hp36">02</span>Dieng
      </div>
      <div class="hp35">
        <span class="hp36">03</span>Yogyakarta
      </div>
      <div class="hp35">
        <span class="hp36">04</span>Karimunjawa
      </div>
      <div class="hp35">
        <span class="hp36">05</span>Ijen
      </div>
      <div class="hp35">
        <span class="hp36">06</span>Destinasi lainnya
      </div>
    </div>
    <div id="darrows" class="hp37">
      <span class="hp38">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5M11 6l-6 6 6 6"></path>
        </svg>
      </span>
      <span class="hp38">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </span>
    </div>
  </div>
</section>
