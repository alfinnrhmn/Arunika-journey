---
import { photo } from '../../lib/photo';
import HFNavRD from '../hf/HFNavRD.astro';
---

<section class="hp1">
  <div class="hs" id="hs">
    <div class="hslide on">
      <img src={photo('JCcWjXTWbr.webp')} alt="Foto hero perjalanan" />
    </div>
    <div class="hslide">
      <img src={photo('kMG6Ggfz-2.jpg')} alt="Gunung berapi dengan padang savana di bawah awan" />
    </div>
    <div class="hslide">
      <img src={photo('UKC-V0YGdo.jpg')} alt="Pejalan di lereng bukit hijau" />
    </div>
    <div class="hslide">
      <img src={photo('-12f39P6ZX.jpg')} alt="Pulau kecil berhutan dari udara" />
    </div>
  </div>
  <div class="hp2"></div>
  <HFNavRD />
  <div class="hp3">
    <h1 class="hp4">
      Travel <i>beyond</i>
      <br />
      the itinerary
    </h1>
    <p class="hp5">
      Perjalanan terorganisir, harga transparan, kuota terlihat. Open Trip dan Private Trip ke
      Bromo, Dieng, Yogyakarta, dan Karimunjawa.
    </p>
  </div>
  <div class="hp6">
    <div class="hp7">
      <span id="hlabel">Yogyakarta</span>
      <span id="hnum" class="hp8">
        01 / 04
      </span>
    </div>
    <div id="hbar" class="hp9">
      <span class="hseg run">
        <i></i>
      </span>
      <span class="hseg">
        <i></i>
      </span>
      <span class="hseg">
        <i></i>
      </span>
      <span class="hseg">
        <i></i>
      </span>
    </div>
    <div class="hp10">
      <span>Gulir untuk menjelajah</span>
      <span class="hp11"></span>
    </div>
  </div>
</section>
