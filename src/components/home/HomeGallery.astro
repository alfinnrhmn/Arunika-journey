---
import { foto } from '../../lib/photo';
import HFArrowButton from '../hf/HFArrowButton.astro';
---

<section class="hp61">
  <div class="hp69">
    <span class="hand">Dokumentasi trip</span>
    <h2 class="hp89">
      Momen di <i>perjalanan</i> kami
    </h2>
    <p class="hp90">
      Cuplikan suasana Open Trip dan Private Trip: pemandangan, peserta, dan momen di sepanjang
      jalan. Contoh tata letak, foto dokumentasi asli [diisi klien].
    </p>
  </div>
  <div class="hp91">
    <a href="/dokumentasi" class="hp-link hp92">
      <img
        class="cover"
        src={foto('anak-muda-jogja')}
        alt="Anak muda berjalan di pelataran bergaya Jawa"
      />
      <div class="hp93"></div>
      <span class="hp94">01</span>
    </a>
    <a href="/dokumentasi" class="hp-link hp95">
      <img class="cover" src={foto('angkringan-malam')} alt="Angkringan malam yang hangat" />
      <div class="hp93"></div>
      <span class="hp94">02</span>
    </a>
    <a href="/dokumentasi" class="hp-link hp96">
      <img
        class="cover"
        src={foto('grup-tertawa-bromo')}
        alt="Rombongan tertawa dengan latar Bromo"
      />
      <div class="hp93"></div>
      <span class="hp94">03</span>
    </a>
    <a href="/dokumentasi" class="hp-link hp97">
      <img
        class="cover"
        src={foto('dermaga-senja-tiga-orang')}
        alt="Tiga teman bersulang di dermaga saat senja"
      />
      <div class="hp93"></div>
      <span class="hp94">04</span>
    </a>
    <a href="/dokumentasi" class="hp-link hp98">
      <img
        class="cover"
        src={foto('malang-warung-jip')}
        alt="Warung kayu dan jip tua di hutan pinus berkabut"
      />
      <div class="hp93"></div>
      <span class="hp94">05</span>
    </a>
    <a href="/dokumentasi" class="hp-link hp99">
      <img
        class="cover"
        src={foto('jemput-tengah-malam')}
        alt="Penjemputan peserta tengah malam di depan penginapan"
      />
      <div class="hp93"></div>
      <span class="hp94">06</span>
    </a>
  </div>
  <div class="hp100">
    <span class="hp101">
      <HFArrowButton href={'/dokumentasi'} label={'Lihat semua dokumentasi'} />
    </span>
  </div>
</section>
