---
import { fi } from './dims';
---

<section class="hp39 hd">
  <span class="hand">Perjalanan berikutnya</span>
  <h3 class="hp40">
    Lewat sini <i>untuk</i> ide
  </h3>
  <div class="hp41">
    <span class="hp42">Jenis trip</span>
    <span class="hp43">Bulan</span>
  </div>
  <div id="jl" class="hp44">
    <div id="jlist" class="hp45">
      <div class="jit on">Budaya dan Sejarah</div>
      <div class="jit">Alam dan Satwa Liar</div>
      <div class="jit">Honeymoon</div>
      <div class="jit">Solo Trip</div>
    </div>
    <div class="jimg">
      <img
        class="jp on"
        {...fi('lorong-batu')}
        loading="lazy"
        decoding="async"
        alt="Lorong batu kuno dengan siluet pejalan"
      />
      <img
        class="jp"
        {...fi('baluran-rusa')}
        loading="lazy"
        decoding="async"
        alt="Rusa di savana Baluran"
      />
      <img
        class="jp"
        {...fi('honeymoon-dermaga')}
        loading="lazy"
        decoding="async"
        alt="Pasangan di dermaga saat senja"
      />
      <img
        class="jp"
        {...fi('traveler-selimut-bromo')}
        loading="lazy"
        decoding="async"
        alt="Pejalan berselimut menatap kabut Bromo"
      />
    </div>
  </div>
  <div class="hp16">
    <span class="hp46">Belum yakin? Klik di sini untuk inspirasi</span>
  </div>
</section>
