---
import { photo } from '../../lib/photo';
import HFArrowButton from '../hf/HFArrowButton.astro';
---

<section class="hp61">
  <div class="hp69">
    <span class="hand">Penginapan pilihan</span>
    <h3 class="hp40">
      Tempat cerita <i>bermula</i>
    </h3>
    <p class="hp70">
      Homestay, lodge di lereng gunung, atau vila di tepi pantai? Kami punya tempat yang pas untuk
      anggaran dan selera Anda. Berikut contoh pilihan menginap di trip kami.
    </p>
  </div>
  <div class="hp71">
    <div class="hp72">
      <div class="hp73">
        <div class="hp74">Cemara Hill Lodge</div>
        <div class="hp75">Bromo, Probolinggo</div>
        <p class="hp76">
          Lodge kecil berkamar enam di lereng, 20 menit dari titik pendakian Penanjakan. Hangat dan
          sederhana, dengan sarapan yang dimasak sendiri oleh pemilik.
        </p>
        <div class="hp77">
          <HFArrowButton label={'Info lengkap'} />
        </div>
      </div>
      <div class="hp78">Rumah Kolonial Kota Lama</div>
      <div class="hp78">Joglo Taman Sari</div>
      <div class="hp78">Glamping Pantai Karimun</div>
      <div class="hp78">Pondok Embun Dieng</div>
      <div class="hp78">Vila Kebun Teh</div>
      <div class="hp78">Camp Savana Baluran</div>
      <div class="hp78">Omah Sawah Borobudur</div>
      <div class="hp78">Pondok Kawah Ijen</div>
      <div class="hp79">Rumah Pantai Parangtritis</div>
    </div>
    <div class="hp80">
      <img class="cover" src={photo('-aGfDzGi3D.jpg')} alt="Cemara Hill Lodge" />
    </div>
  </div>
</section>
