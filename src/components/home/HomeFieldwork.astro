---
import { fi } from './dims';
---

<section class="hp81 hd">
  <div class="hp82">
    <span class="hand">Langsung di lapangan</span>
    <h3 class="hp40">
      Lebih <i>dekat</i>
    </h3>
    <p class="hp83">
      Destinasi kami menawarkan sesuatu yang benar-benar istimewa. Kami menghindari area yang klise,
      dan mengisi trip dengan pemandangan yang belum tersentuh, warga lokal, dan perjumpaan dengan
      satwa jauh dari keramaian.
    </p>
  </div>
  <div class="hp84">
    <a href="/dokumentasi" class="hp-link hp85">
      <img
        class="cover"
        {...fi('tangan-relief-candi')}
        loading="lazy"
        decoding="async"
        alt="Tangan menyentuh relief batu candi"
      />
      <span class="hp86">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M8 5.5v13l11-6.5z"></path>
        </svg>
      </span>
    </a>
    <a href="/dokumentasi" class="hp-link hp85">
      <img
        class="cover"
        {...fi('pedagang-warung-kabut')}
        loading="lazy"
        decoding="async"
        alt="Pedagang di warung tepi kebun berkabut"
      />
      <span class="hp86">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M8 5.5v13l11-6.5z"></path>
        </svg>
      </span>
    </a>
    <a href="/dokumentasi" class="hp-link hp85">
      <img
        class="cover"
        {...fi('kubis-embun')}
        loading="lazy"
        decoding="async"
        alt="Kubis berembun di kebun dataran tinggi"
      />
      <span class="hp86">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M8 5.5v13l11-6.5z"></path>
        </svg>
      </span>
    </a>
    <a href="/dokumentasi" class="hp-link hp85">
      <img
        class="cover"
        {...fi('penambang-belerang')}
        loading="lazy"
        decoding="async"
        alt="Penambang belerang memikul keranjang di lereng"
      />
      <span class="hp86">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M8 5.5v13l11-6.5z"></path>
        </svg>
      </span>
    </a>
  </div>
</section>
