---
// Kartu cerita (acuan Doop: HFJournalCard). Judul adalah satu-satunya tautan; seluruh kartu bisa diklik lewat
// tautan yang direntangkan (::after). Rasio gambar berbeda untuk desktop (`ratio`) dan tablet/mobile (`ratioSmall`).
import type { Story } from '../../content/journal';
import { cardLabel, readLabel } from '../../content/journal';
import { jfoto } from './photo-dims';

interface Props {
  story: Story;
  ratio?: 'portrait' | 'tall' | 'square';
  ratioSmall?: 'portrait' | 'tall' | 'square';
}
const { story, ratio = 'portrait', ratioSmall = ratio } = Astro.props;
---

<article class="jn-card jn-rv" data-ratio={ratio} data-ratio-s={ratioSmall}>
  <div class="jn-img">
    <div class="jn-px">
      <div class="jn-zoom">
        <img
          class="cover"
          {...jfoto(story.cover.foto)}
          alt={story.cover.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
    <span class="jn-time">{readLabel(story)}</span>
    {story.sample && <span class="jn-sample">Contoh</span>}
  </div>
  <div class="jn-meta">{cardLabel(story)}</div>
  <h3 class="jn-title">
    <a href={`/journal/${story.slug}`}>{story.title}</a>
  </h3>
  <p class="jn-desc">{story.excerpt}</p>
  <span class="jn-more" aria-hidden="true">
    <span>Baca cerita</span>
    <svg
      width="18"
      height="10"
      viewBox="0 0 18 10"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M1 5h15M12 1l4 4-4 4"></path>
    </svg>
  </span>
</article>
