---
// Halaman sebelumnya/berikutnya: hanya dirender bila ada lebih dari satu halaman data.
import type { ListResult } from '../../content/journal';
import HFArrowButton from '../hf/HFArrowButton.astro';
import { listHref } from './journal-url';

interface Props {
  result: ListResult;
}
const { result } = Astro.props;
const { page, totalPages, items, total } = result;
const topik = result.topic?.slug ?? null;
const destinasi = result.destinasi?.slug ?? null;
const href = (halaman: number) => listHref({ topik, destinasi, halaman });
const nums = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{totalPages > 1 && (
  <nav class="jn-pager" aria-label="Halaman daftar cerita">
    <p class="jn-pager-info">
      Halaman {page} dari {totalPages} · {items.length} dari {total} cerita
    </p>
    <div class="jn-pager-nav">
      {page > 1 && (
        <a class="jn-prev" href={href(page - 1)} rel="prev">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5M11 6l-6 6 6 6"></path>
          </svg>
          <span>Halaman sebelumnya</span>
        </a>
      )}
      <ul class="jn-pgs">
        {nums.map((n) => (
          <li>
            <a
              class="jn-pg"
              href={href(n)}
              aria-label={`Halaman ${n}`}
              aria-current={n === page ? 'page' : undefined}
            >
              {n}
            </a>
          </li>
        ))}
      </ul>
      {page < totalPages && (
        <span class="jn-next">
          <HFArrowButton tone="outline" label="Halaman berikutnya" href={href(page + 1)} />
        </span>
      )}
    </div>
  </nav>
)}
