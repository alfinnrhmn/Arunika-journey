---
import { aboutValues } from '../../content/about';
---

<section class="ab-values" aria-labelledby="ab-values-h">
  <div class="ab-head">
    <p class="ab-eyebrow">{aboutValues.eyebrow}</p>
    <h2 class="ab-h2" id="ab-values-h">
      {aboutValues.titleA} <i>{aboutValues.titleI}</i>
      {` ${aboutValues.titleB}`}
    </h2>
  </div>
  <ol class="ab-cols4">
    {aboutValues.items.map((v, i) => (
      <li class="ab-col">
        <span class="ab-num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="ab-h3">{v.title}</h3>
        <p class="ab-p">{v.text}</p>
      </li>
    ))}
  </ol>
</section>
