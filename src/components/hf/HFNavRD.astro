---
// Header situs gaya Red Dot (acuan: header Home desktop): logo di kolom 376px, lima tautan di kolom
// 453px, lalu "Cek Status Booking" dan CTA pil rata kanan. tone=overlay transparan di atas hero
// (absolute di puncak induk berposisi), tone=solid di atas kertas. Semua layar desktop memakai tata letak ini.
interface Props {
  tone?: 'overlay' | 'solid';
  cta?: string;
  ctaHref?: string;
  /** light: CTA berlatar kertas dengan teks ink, agar kontras di atas foto hero. */
  ctaTone?: 'default' | 'light';
}
const {
  tone = 'overlay',
  cta = 'Lihat jadwal',
  ctaHref = '/trips',
  ctaTone = 'default',
} = Astro.props;
---

<header class="hf-rdn" data-tone={tone}>
  <a class="logo" href="/" aria-label="Arunika Journey, beranda">
    Arunika
  </a>
  <nav class="l" aria-label="Utama">
    <a href="/trips">Open Trip</a>
    <a href="/private-trip">Private Trip</a>
    <a href="/dokumentasi">Destinasi</a>
    <a href="/about">Tentang Kami</a>
    <a href="/journal">Journal</a>
  </nav>
  <div class="r">
    <a class="st" href="/cek-status">
      Cek Status Booking
    </a>
    <a class="pill" data-cta-tone={ctaTone} href={ctaHref}>
      {cta}
    </a>
  </div>
</header>

<style>
  .hf-rdn {
    /* Tiga kolom: logo | menu | kanan. Menu selalu di tengah header pada lebar layar berapa pun. */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    height: 92px;
    padding: 0 41px;
    font-family: var(--font-ui);
    color: var(--color-paper);
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 6;
  }
  .hf-rdn[data-tone='solid'] {
    position: relative;
    color: var(--color-ink);
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }
  .hf-rdn a {
    color: inherit;
    text-decoration: none;
  }
  .hf-rdn .logo {
    justify-self: start;
    font-family: var(--font-serif);
    font-size: 34px;
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.01em;
  }
  .hf-rdn .l {
    justify-self: center;
    display: flex;
    gap: 28px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    opacity: 0.85;
    white-space: nowrap;
  }
  .hf-rdn .r {
    justify-self: end;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 28px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .hf-rdn .st {
    opacity: 0.85;
  }
  .hf-rdn .pill {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 26px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-paper) 20%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-paper) 35%, transparent);
    font-weight: 600;
  }
  .hf-rdn .pill[data-cta-tone='light'] {
    background: var(--color-paper);
    border-color: var(--color-paper);
    color: var(--color-ink);
  }
  .hf-rdn[data-tone='solid'] .pill {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
</style>
