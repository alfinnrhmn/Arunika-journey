---
// Header situs gaya Red Dot (acuan: header Home desktop, HFNavRD / HFNavRDMobile di Doop).
// >= 1280px: logo di kolom kiri, lima tautan di tengah, "Cek Status Booking" dan CTA pil rata kanan
// (tata letak desktop tidak diubah). < 1280px (tablet dan mobile): tinggi 64px, tombol menu di kiri,
// wordmark di tengah, CTA pil di kanan; menu penuh layar (latar night) dibuka dari tombol menu.
// tone=overlay transparan di atas hero (absolute di puncak induk berposisi), tone=solid di atas kertas;
// keduanya bekerja di semua lebar.
//
// Menu tanpa JavaScript: tombol menu awalnya tautan `#hf-menu` dan panelnya tampil lewat `:target`
// (tutup: tautan `#hf-tutup`). Setelah src/scripts/nav.ts dimuat, tautan itu digantikan <button
// aria-expanded aria-controls>, panel dipindah ke <body> (agar di atas semua halaman dan tidak ikut
// terpotong transform induk), halaman di belakangnya `inert`, gulir dikunci, Esc menutup dan fokus
// kembali ke tombol.
//
// `#konten` (span nol-ukuran di ujung header) adalah target tautan "Lewati ke konten" di layout Public.
interface Props {
  tone?: 'overlay' | 'solid';
  cta?: string;
  ctaHref?: string;
  /** light: CTA berlatar kertas dengan teks ink, agar kontras di atas foto hero. */
  ctaTone?: 'default' | 'light';
}
const {
  tone = 'overlay',
  cta = 'Lihat jadwal',
  ctaHref = '/trips',
  ctaTone = 'default',
} = Astro.props;
---

<header class="hf-rdn" data-tone={tone}>
  <a class="mopen" href="#hf-menu" aria-label="Buka menu navigasi" data-menu-link>
    <span class="mb" aria-hidden="true">
      <i></i>
      <i></i>
    </span>
  </a>
  <button
    class="mbtn"
    type="button"
    aria-expanded="false"
    aria-controls="hf-menu"
    aria-label="Buka menu navigasi"
    data-menu-btn
  >
    <span class="mb" aria-hidden="true">
      <i></i>
      <i></i>
    </span>
  </button>
  <a class="logo" href="/" aria-label="Arunika Journey, beranda">
    Arunika
  </a>
  <nav class="l" aria-label="Utama">
    <a href="/trips">Open Trip</a>
    <a href="/private-trip">Private Trip</a>
    <a href="/dokumentasi">Destinasi</a>
    <a href="/about">Tentang Kami</a>
    <a href="/journal">Journal</a>
  </nav>
  <div class="r">
    <a class="st" href="/cek-status">
      Cek Status Booking
    </a>
    <a class="pill" data-cta-tone={ctaTone} href={ctaHref}>
      {cta}
    </a>
  </div>

  <div
    class="hf-menu"
    id="hf-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Menu navigasi"
    data-menu-panel
  >
    <div class="hf-menu-bar">
      <a class="hf-menu-x" href="#hf-tutup" aria-label="Tutup menu" data-menu-close>
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </a>
      <a class="hf-menu-wm" href="/" aria-label="Arunika Journey, beranda">
        Arunika
      </a>
    </div>
    <nav class="hf-menu-nav" aria-label="Menu utama">
      <a class="big" href="/trips">
        <span>Open Trip</span>
        <small aria-hidden="true">01</small>
      </a>
      <a class="big" href="/private-trip">
        <span>Private Trip</span>
        <small aria-hidden="true">02</small>
      </a>
      <a class="big" href="/dokumentasi">
        <span>
          Destinasi <i>dan</i> Dokumentasi
        </span>
        <small aria-hidden="true">03</small>
      </a>
      <div class="sm">
        <a href="/about">Tentang Kami</a>
        <a href="/journal">Journal</a>
        <a href="/cek-status">
          <span>Cek Status Booking</span>
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a href="/contact">Hubungi Kami</a>
      </div>
    </nav>
    <div class="hf-menu-foot">
      <div class="act">
        <a class="hf-menu-cta" href={ctaHref}>
          <span>{cta}</span>
          <span class="ic" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </span>
        </a>
        <div class="wa">
          <span>Tanya via WhatsApp</span>
          <b>[diisi klien]</b>
        </div>
      </div>
      <div class="lg">Legalitas usaha: [diisi klien]</div>
    </div>
  </div>

  <span class="skip-target" id="konten" tabindex="-1"></span>
</header>

<script>
  import '../../scripts/nav.ts';
</script>

<style>
  .hf-rdn {
    /* Tiga kolom: logo | menu | kanan. Menu selalu di tengah header pada lebar layar berapa pun. */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    height: 92px;
    padding: 0 41px;
    font-family: var(--font-ui);
    color: var(--color-paper);
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 6;
  }
  .hf-rdn[data-tone='solid'] {
    position: relative;
    color: var(--color-ink);
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }
  .hf-rdn a {
    color: inherit;
    text-decoration: none;
  }
  .hf-rdn .logo {
    justify-self: start;
    font-family: var(--font-serif);
    font-size: 34px;
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.01em;
  }
  .hf-rdn .l {
    justify-self: center;
    display: flex;
    gap: 28px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    opacity: 0.85;
    white-space: nowrap;
  }
  .hf-rdn .r {
    justify-self: end;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 28px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .hf-rdn .st {
    opacity: 0.85;
  }
  .hf-rdn .pill {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 26px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-paper) 20%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-paper) 35%, transparent);
    font-weight: 600;
  }
  .hf-rdn .pill[data-cta-tone='light'] {
    background: var(--color-paper);
    border-color: var(--color-paper);
    color: var(--color-ink);
  }
  .hf-rdn[data-tone='solid'] .pill {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }

  /* Elemen yang hanya dipakai < 1280px: tersembunyi di desktop. */
  .hf-rdn .mopen,
  .hf-rdn .mbtn,
  .hf-menu {
    display: none;
  }
  /* Target pintasan "Lewati ke konten": nol-ukuran, di luar alur, tidak mengubah tata letak. */
  .hf-rdn .skip-target {
    position: absolute;
    top: 100%;
    left: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    outline: none;
  }
  .hf-rdn[data-tone='overlay'] .skip-target {
    top: 0;
  }
  /* Fokus terlihat memakai warna teks header (ink di atas kertas, kertas di atas foto hero). */
  .hf-rdn :focus-visible {
    outline-color: currentColor;
  }

  /* Tablet dan mobile (< 1280): tombol menu, wordmark tengah, CTA pil. */
  @media (max-width: 1279px) {
    .hf-rdn {
      height: 64px;
      padding: 0 16px;
    }
    .hf-rdn .l,
    .hf-rdn .st {
      display: none;
    }
    .hf-rdn .mopen,
    .hf-rdn .mbtn {
      display: flex;
      justify-self: start;
      align-items: center;
      justify-content: flex-start;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
    }
    /* Setelah skrip menu dimuat: tombol sungguhan menggantikan tautan. */
    .hf-rdn .mbtn {
      display: none;
    }
    :global(html.hf-js) .hf-rdn .mopen {
      display: none;
    }
    :global(html.hf-js) .hf-rdn .mbtn {
      display: flex;
    }
    .hf-rdn .mb {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 44px;
      height: 44px;
      padding-left: 10px;
    }
    .hf-rdn .mb i {
      display: block;
      width: 24px;
      height: 1.5px;
      background: currentColor;
    }
    .hf-rdn .logo {
      justify-self: center;
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 0 8px;
      font-size: 26px;
    }
    .hf-rdn .pill {
      padding: 0 16px;
      font-size: 13px;
    }
    /* Tanpa JS: panel terbuka lewat :target; halaman di belakangnya dikunci dan header naik di atas. */
    .hf-menu {
      position: fixed;
      inset: 0;
      z-index: 100;
      flex-direction: column;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--color-night);
      color: var(--color-paper);
      font-family: var(--font-ui);
    }
    .hf-menu[data-open],
    :global(html:not(.hf-js)) .hf-menu:target {
      display: flex;
    }
    .hf-rdn:has(.hf-menu:target) {
      z-index: 100;
    }
    .hf-menu :focus-visible {
      outline-color: var(--color-paper);
    }
    .hf-menu a {
      color: inherit;
      text-decoration: none;
    }
    .hf-menu-bar {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      flex: none;
      height: 64px;
      padding: 0 16px;
    }
    .hf-menu-x {
      position: absolute;
      left: 16px;
      top: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid color-mix(in srgb, var(--color-paper) 40%, transparent);
    }
    .hf-menu-wm {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 0 12px;
      font-family: var(--font-serif);
      font-size: 26px;
      line-height: 1;
      font-weight: 300;
      letter-spacing: -0.01em;
    }
    .hf-menu-nav {
      flex: none;
      padding: 8px 20px 0;
    }
    .hf-menu .big {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 76px;
      padding: 12px 0;
      line-height: 1.05;
      border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 18%, transparent);
      font-family: var(--font-serif);
      font-weight: 300;
      font-size: 34px;
      letter-spacing: -0.015em;
    }
    .hf-menu .big small {
      flex: none;
      font-family: var(--font-ui);
      font-size: 12px;
      letter-spacing: 0.1em;
      color: color-mix(in srgb, var(--color-paper) 55%, transparent);
    }
    .hf-menu .sm {
      margin-top: 14px;
      display: grid;
      grid-template-columns: 1fr;
    }
    .hf-menu .sm a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 48px;
      font-size: 16px;
    }
    .hf-menu-foot {
      flex: none;
      margin-top: auto;
      padding: 32px 20px max(28px, env(safe-area-inset-bottom));
    }
    .hf-menu-cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 22px;
      height: 56px;
      padding: 0 6px 0 26px;
      border-radius: var(--radius-pill);
      border: 1px solid currentColor;
      font-size: 15px;
      line-height: 20px;
      font-weight: 500;
      letter-spacing: 0.005em;
      white-space: nowrap;
    }
    .hf-menu-cta .ic {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid currentColor;
    }
    .hf-menu .wa {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 44px;
      margin-top: 20px;
      font-size: 14px;
      color: color-mix(in srgb, var(--color-paper) 75%, transparent);
    }
    .hf-menu .wa b {
      font-weight: 600;
      color: var(--color-paper);
    }
    .hf-menu .lg {
      margin-top: 6px;
      font-size: 12px;
      line-height: 18px;
      color: color-mix(in srgb, var(--color-paper) 55%, transparent);
    }
  }

  /* Tablet (768-1279): bidang sentuh lebih lega, tautan kecil dua kolom, CTA di samping WhatsApp. */
  @media (min-width: 768px) and (max-width: 1279px) {
    .hf-rdn {
      padding: 0 32px 0 22px;
    }
    .hf-rdn .logo {
      font-size: 28px;
    }
    .hf-menu-bar {
      padding: 0 32px 0 28px;
    }
    .hf-menu-x {
      left: 28px;
    }
    .hf-menu-wm {
      font-size: 28px;
    }
    .hf-menu-nav {
      padding: 40px 32px 0;
    }
    .hf-menu .big {
      min-height: 100px;
      font-size: clamp(44px, 6.4vw, 52px);
      letter-spacing: -0.02em;
    }
    .hf-menu .big small {
      font-size: 13px;
    }
    .hf-menu .sm {
      margin-top: 24px;
      grid-template-columns: 1fr 1fr;
      gap: 0 32px;
    }
    .hf-menu .sm a {
      min-height: 56px;
      font-size: 18px;
      border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 10%, transparent);
    }
    .hf-menu-foot {
      padding: 32px 32px max(40px, env(safe-area-inset-bottom));
    }
    .hf-menu .act {
      display: flex;
      align-items: center;
      gap: 32px;
    }
    .hf-menu-cta {
      flex: none;
    }
    .hf-menu .wa {
      flex: 1;
      margin-top: 0;
    }
    .hf-menu .lg {
      margin-top: 16px;
      line-height: 16px;
    }
  }

  /* Menu penuh layar tidak ada di desktop (urutan terakhir agar menang atas aturan tampil di atas). */
  /* Mobile: CTA header dibuat ringkas supaya wordmark yang jadi sorotan (ukuran wordmark tidak diubah). Yang tampak
     hanya pil 28px dengan teks 11px; area ketuk tetap 44px tinggi lewat ::before yang tak terlihat. */
  @media (max-width: 767px) {
    .hf-rdn .pill {
      position: relative;
      height: 28px;
      padding: 0 10px;
      font-size: 11px;
      line-height: 1;
    }
    .hf-rdn .pill::before {
      content: '';
      position: absolute;
      inset: -8px -4px;
    }
  }

  @media (min-width: 1280px) {
    .hf-menu,
    .hf-menu[data-open],
    :global(html:not(.hf-js)) .hf-menu:target {
      display: none;
    }
  }
</style>
