---
// Tombol pil dengan label dan panah bulat. tone: outline (di atas kertas), light (di atas foto/gelap),
// dark (terisi, satu-satunya gaya CTA utama). Menjadi <a> bila ada href.
interface Props {
  tone?: 'outline' | 'light' | 'dark';
  label?: string;
  href?: string;
}
const { tone = 'outline', label = 'Tentang kami', href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="hf-ab" data-tone={tone} href={href}>
  <span class="l">{label}</span>
  <span class="ic">
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </span>
</Tag>

<style>
  .hf-ab {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    height: 56px;
    padding: 0 6px 0 26px;
    border-radius: var(--radius-pill);
    border: 1px solid currentColor;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 20px;
    font-weight: 500;
    letter-spacing: 0.005em;
    white-space: nowrap;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .hf-ab .ic {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid currentColor;
  }
  .hf-ab[data-tone='light'] {
    color: var(--color-paper);
  }
  .hf-ab[data-tone='dark'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
</style>
