---
// Footer gaya Red Dot di atas latar ink: baris newsletter, wordmark besar dengan kolom Lokasi / Kontak /
// Booking, baris legal dengan placeholder izin, tautan kebijakan, dan hak cipta dengan tombol kembali ke atas.
// >= 1280px: tata letak desktop (acuan HFFooterRD 1440). < 1280px mengikuti HFFooterRDMobile: satu kolom
// (newsletter, wordmark, kolom tautan 3 kolom di tablet / 2 kolom di mobile, legal, tautan kebijakan,
// hak cipta). Lingkaran placeholder izin tetap tampil (lebih kecil) agar isian klien tidak hilang.
const year = new Date().getFullYear();
---

<footer class="hf-rdf">
  <div class="top">
    <span class="t">Daftar untuk kabar dan pembaruan</span>
    <div class="field">
      <span>Berlangganan newsletter kami</span>
      <span class="ic">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </span>
    </div>
  </div>
  <div class="mid">
    <div class="brand">
      Arunika
      <br />
      <i>Journey</i>
    </div>
    <div class="col">
      <b>Lokasi</b>
      <a href="/trips?destinasi=bromo">Bromo</a>
      <a href="/trips?destinasi=dieng">Dieng</a>
      <a href="/trips?destinasi=yogyakarta">Yogyakarta</a>
      <a href="/trips?destinasi=karimunjawa">Karimunjawa</a>
      <a href="/dokumentasi">Destinasi lainnya</a>
    </div>
    <div class="col">
      <b>Kontak</b>
      <span>WhatsApp</span>
      <span>halo@arunikajourney.id</span>
      <span>Instagram</span>
    </div>
    <div class="col">
      <b>Booking</b>
      <a href="/help#panduan">Panduan Booking</a>
      <a href="/help#pembayaran">Informasi Pembayaran</a>
      <a href="/legal/pembatalan-refund">Pembatalan dan Refund</a>
      <a href="/cek-status">Cek Status Booking</a>
    </div>
  </div>
  <div class="legalrow">
    <div class="legal">
      Arunika Journey adalah penyelenggara perjalanan wisata. Legalitas dan nomor izin usaha: [diisi
      klien].
    </div>
    <div class="badges">
      <span>
        Mitra
        <br />
        [diisi klien]
      </span>
      <span>
        Izin
        <br />
        [diisi klien]
      </span>
      <span>
        Asuransi
        <br />
        [diisi klien]
      </span>
      <span>
        Penghargaan
        <br />
        [diisi klien]
      </span>
    </div>
  </div>
  <div class="bot">
    <div class="links">
      <a href="/legal/syarat-ketentuan">Syarat dan Ketentuan</a>
      <a href="/legal/kebijakan-privasi">Kebijakan Privasi</a>
      <a href="/help">FAQ</a>
      <a href="/dokumentasi#testimoni">Testimoni Terverifikasi</a>
      <a href="/contact">Hubungi Kami</a>
    </div>
    <div class="cp">
      <span>© {year} Arunika Journey. Hak cipta dilindungi.</span>
      <a class="up" href="#top" aria-label="Kembali ke atas">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 19V5M6 11l6-6 6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .hf-rdf {
    width: 100%;
    padding: 96px 41px 40px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-ui);
  }
  .hf-rdf a {
    color: inherit;
    text-decoration: none;
  }
  .hf-rdf .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(244, 243, 239, 0.2);
  }
  .hf-rdf .top .t {
    font-family: var(--font-serif);
    font-size: var(--text-heading);
    line-height: 36px;
    font-weight: 300;
  }
  .hf-rdf .field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 520px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(244, 243, 239, 0.5);
    font-size: 15px;
    opacity: 0.9;
  }
  .hf-rdf .ic,
  .hf-rdf .up {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(244, 243, 239, 0.5);
  }
  .hf-rdf .mid {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    padding: 64px 0;
  }
  .hf-rdf .brand {
    width: 420px;
    font-family: var(--font-serif);
    font-size: 64px;
    line-height: 60px;
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  .hf-rdf .brand i {
    font-size: 36px;
    opacity: 0.7;
  }
  .hf-rdf .col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    line-height: 20px;
    min-width: 180px;
  }
  .hf-rdf .col b {
    margin-bottom: 8px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.55;
  }
  .hf-rdf .col span,
  .hf-rdf .col a {
    opacity: 0.88;
  }
  .hf-rdf .legalrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    padding-bottom: 48px;
  }
  .hf-rdf .legal {
    max-width: 760px;
    font-size: 13px;
    line-height: 20px;
    opacity: 0.6;
  }
  .hf-rdf .badges {
    display: flex;
    gap: 16px;
  }
  .hf-rdf .badges span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    border: 1px dashed rgba(244, 243, 239, 0.45);
    text-align: center;
    font-size: 10px;
    line-height: 13px;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }
  .hf-rdf .bot {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 28px;
    border-top: 1px solid rgba(244, 243, 239, 0.2);
  }
  .hf-rdf .links {
    display: flex;
    gap: 32px;
    font-size: 13px;
    opacity: 0.8;
  }
  .hf-rdf .cp {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    opacity: 0.7;
  }

  /* Tablet (< 1280): satu kolom, wordmark di atas tiga kolom tautan. Tautan dan tombol >= 44px (sentuh). */
  @media (max-width: 1279px) {
    .hf-rdf {
      padding: 56px 32px 28px;
    }
    .hf-rdf .top {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      padding-bottom: 0;
      border-bottom: 0;
    }
    .hf-rdf .top .t {
      font-size: 26px;
      line-height: 32px;
    }
    .hf-rdf .field {
      width: 100%;
    }
    .hf-rdf .ic,
    .hf-rdf .up {
      flex: none;
    }
    .hf-rdf .up {
      width: 44px;
      height: 44px;
    }
    .hf-rdf .mid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px 24px;
      padding: 40px 0 0;
    }
    .hf-rdf .brand {
      grid-column: 1 / -1;
      width: auto;
      font-size: 56px;
      line-height: 52px;
    }
    .hf-rdf .brand i {
      font-size: 30px;
    }
    .hf-rdf .col {
      gap: 0;
      min-width: 0;
      font-size: 14px;
    }
    .hf-rdf .col b {
      margin-bottom: 6px;
    }
    .hf-rdf .col a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    .hf-rdf .col span {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    .hf-rdf .legalrow {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      margin-top: 36px;
      padding: 24px 0 0;
      border-top: 1px solid rgba(244, 243, 239, 0.2);
    }
    .hf-rdf .legal {
      max-width: none;
      font-size: 12px;
      line-height: 18px;
    }
    .hf-rdf .badges {
      gap: 12px;
    }
    .hf-rdf .badges span {
      width: 72px;
      height: 72px;
      font-size: 9px;
      line-height: 12px;
    }
    .hf-rdf .bot {
      gap: 0;
      padding-top: 0;
      margin-top: 12px;
      border-top: 0;
    }
    .hf-rdf .links {
      flex-wrap: wrap;
      gap: 0 20px;
    }
    .hf-rdf .links a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
    .hf-rdf .cp {
      gap: 16px;
      margin-top: 16px;
      font-size: 12px;
    }
  }

  /* Mobile (< 768): dua kolom tautan; kolom ketiga turun ke baris berikutnya. */
  @media (max-width: 767px) {
    .hf-rdf {
      padding: 56px 20px 28px;
    }
    .hf-rdf .mid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 20px;
    }
    .hf-rdf .links {
      gap: 0 16px;
    }
  }

  /* Layar sangat sempit (<= 359): empat lingkaran izin tidak muat satu baris (4 x 72 + jarak > 280px);
     disusun 2 x 2 supaya tidak meluapkan halaman. */
  @media (max-width: 359px) {
    .hf-rdf .badges {
      display: grid;
      grid-template-columns: repeat(2, 72px);
    }
  }
</style>
