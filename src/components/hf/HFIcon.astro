---
// Ikon garis 1,5px (currentColor). Diport dari komponen Doop HFIcon.
type Name =
  | 'calendar'
  | 'users'
  | 'shield'
  | 'check'
  | 'pin'
  | 'chat'
  | 'clock'
  | 'arrow'
  | 'plus'
  | 'minus'
  | 'file'
  | 'star';
interface Props {
  name?: Name;
  /** Doop mengirim ukuran sebagai teks ("16"), jadi keduanya diterima. */
  size?: 16 | 20 | 24 | '16' | '20' | '24';
}
const { name = 'calendar', size: sizeProp = 20 } = Astro.props;
const size = Number(sizeProp);

const paths: Record<Name, string> = {
  calendar:
    '<rect x="3.5" y="5" width="17" height="15" rx="2"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path>',
  users:
    '<circle cx="9" cy="8.5" r="3.5"></circle><path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5"></path><circle cx="17.5" cy="9.5" r="2.5"></circle><path d="M17.5 14.5c2.4.2 4 1.8 4.5 4.5"></path>',
  shield:
    '<path d="M12 3l7.5 3v5.5c0 4.6-3.1 8-7.5 9.5-4.4-1.5-7.5-4.9-7.5-9.5V6z"></path><path d="M8.5 12l2.5 2.5 4.5-5"></path>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"></path>',
  pin: '<path d="M12 21s7-6.2 7-11.5a7 7 0 10-14 0C5 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle>',
  chat: '<path d="M4 5.5h16v11H11l-5 4v-4H4z"></path>',
  clock: '<circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path>',
  arrow: '<path d="M4 12h16M14 6l6 6-6 6"></path>',
  plus: '<path d="M12 5v14M5 12h14"></path>',
  minus: '<path d="M5 12h14"></path>',
  file: '<path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v4h4M9 12h6M9 16h6"></path>',
  star: '<path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 17l-5.2 2.7 1-5.9L3.5 9.7l5.9-.8z"></path>',
};
---

<span class="hf-ic" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={paths[name]}
  />
</span>

<style>
  .hf-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .hf-ic svg {
    width: 100%;
    height: 100%;
  }
</style>
