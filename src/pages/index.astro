---
import Public from '../layouts/Public.astro';
---

<Public title="Arunika Journey">
  <main class="mx-auto flex min-h-screen max-w-page flex-col justify-center gap-6 px-6">
    <p class="text-dawn-deep text-caption tracking-[0.14em] uppercase">Arunika Journey</p>
    <h1 class="text-h1 md:text-display leading-[1.05]">
      Travel <i>beyond</i> the itinerary
    </h1>
    <p class="text-ink-2 text-lead max-w-xl">
      Kerangka proyek siap. Halaman publik dibangun mengikuti desain di Doop (Design V2).
    </p>
  </main>
</Public>
