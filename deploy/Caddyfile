# TLS_MODE = email (Let's Encrypt, DNS publik mengarah ke server) atau `internal` (uji/LAN).
# Bila Cloudflare ada di depan, set mode SSL "Full (strict)".
{$SITE_HOST} {
	tls {$TLS_MODE}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Dashboard dan halaman status tidak boleh diindeks mesin pencari.
	@private path /dashboard* /cek-status* /booking*
	header @private X-Robots-Tag "noindex, nofollow"

	reverse_proxy app:4321
}
