# Salin menjadi deploy/.env di server dan isi SEMUA nilai. Jangan commit file hasilnya.
# Rahasia acak:  openssl rand -base64 48

ARUNIKA_PROJECT=arunika
# Tag rilis yang sedang dipasang (mis. v0.1.0). Dipakai untuk menamai image.
ARUNIKA_VERSION=
SITE_HOST=arunikajourney.example
# Email untuk Lets Encrypt, atau `internal` untuk uji/LAN.
TLS_MODE=

DB_NAME=arunika
DB_USER=arunika
DB_PASSWORD=
BETTER_AUTH_SECRET=
